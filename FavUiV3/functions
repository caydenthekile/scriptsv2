function wfuncs:isalivecheck()
    local humanoid 
    pcall(function()
        humanoid = wfuncs.lp.Character.Humanoid
    end)
    if humanoid ~= nil then
        if humanoid.Health>0 then
            return true
        else
            return false
        end
    else
        return false
    end
end
function wfuncs:nc(val)
    local newvel = Instance.new('BodyVelocity')
    newvel.Name = 'idkkkk'
    newvel.Velocity = Vector3.new(0, 0, 0)
    if wfuncs:isalivecheck() then
        if val then
            if not ply.Character:WaitForChild('HumanoidRootPart'):FindFirstChild(newvel.Name) then
                newvel.Parent = ply.Character:WaitForChild('HumanoidRootPart')
            end
        elseif not val or val == nil then
            for i, v in next, ply.Character:WaitForChild('HumanoidRootPart'):GetChildren() do
                if v.Name == newvel.Name then
                    v:Destroy()
                end
            end
        end
    end
end
function wfuncs:getdist(part)
    local dist
    if wfuncs:isalivecheck() then
        if wfuncs:getroot() then
            dist = (wfuncs:getroot().Position - part.Position).Magnitude
        end
    end
    return dist
end
function wfuncs:tp(place)
    if wfuncs:isalivecheck() then
        wfuncs:getroot().CFrame = place.CFrame
    end
end
function wfuncs:generateNumbers(count)
    local numbers = {}
    local interval = 1 / (count - 1)
    for i = 0, count - 1 do
        local number = interval * i
        if number ~= 0 then
            table.insert(numbers, number)
        end
    end
    return numbers
end
function wfuncs:tpsafe(place, s, div)
    if wfuncs:isalivecheck() then
        local speed = s or 0
        local count = div or 10
        local amt = wfuncs:generateNumbers(count)
        local start = wfuncs:getroot().Position
        local endPos = place.Position
        local totalDistance = (endPos - start).Magnitude
        for i, v in ipairs(amt) do
            local spot
            if i == 1 then
                spot = start
            else
                spot = start:Lerp(endPos, v)
            end
            wfuncs:nc(true)
            wfuncs:getroot().CFrame = CFrame.new(spot)
            task.wait(speed)
            local currentDistance = (spot - start).Magnitude
            if currentDistance >= totalDistance then
                break
            end
        end
    end
end
