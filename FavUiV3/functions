function wfuncs:isalivecheck()
    local humanoid 
    pcall(function()
        humanoid = wfuncs.lp.Character.Humanoid
    end)
    if humanoid ~= nil then
        if humanoid.Health>0 then
            return true
        else
            return false
        end
    else
        return false
    end
end
function wfuncs:getchar()
    if wfuncs:isalivecheck() then
        return wfuncs.lp.Character
    end
end
function wfuncs:nc()
    local old_states = {}
    local function restore()
        for i,v in next,wfuncs:getroot():GetChildren() do
            if v.Name == "WoUVel" then
                v:Destroy()
            end
        end
        for i,v in next,wfuncs:getchar():GetChildren() do
            if v:IsA("Part") then
                v.CanCollide = old_states[v.Name]
            end
        end
        for i2,v2 in next,old_states do
        end
    end
    local tbl = {
    }
    tbl['thread'] = wfuncs:create_thread(function(state)
        while true and task.wait() do
            if not state.running then coroutine.yield() end
            if not wfuncs:isalivecheck() then return end
            if not wfuncs:checkfor(wfuncs:getroot(),"WoUVel") then
                local vel = Instance.new('BodyVelocity',wfuncs:getroot())
                vel.Velocity = Vector3.new(0, 0, 0)
                vel.Name = "WoUVel"
            end
            for i,v in next,wfuncs:getchar():GetChildren() do
                if v:IsA("Part") then
                    if not old_states[v.Name] then
                        old_states[v.Name] = v.CanCollide
                    end
                    v.CanCollide = false
                end
            end
        end
    end)
    function tbl:Fire()
        tbl.thread:resume()
    end
    function tbl:Stop()
        repeat task.wait() until wfuncs:isalivecheck()
        restore()
        tbl.thread:pause()
    end
    return tbl
end
function wfuncs:getdist(part)
    local dist
    if wfuncs:isalivecheck() then
        if wfuncs:getroot() then
            dist = (wfuncs:getroot().Position - part.Position).Magnitude
        end
    end
    return dist
end
function wfuncs:tp(place,alter)
    if not atler then
        if wfuncs:isalivecheck() then
            wfuncs:getroot().CFrame = place.CFrame
        end
    else
        if wfuncs:isalivecheck() then
            wfuncs:getroot().CFrame = place.CFrame * alter
        end
    end
end
function wfuncs:generateNumbers(count)
    local numbers = {}
    local interval = 1 / (count - 1)
    for i = 0, count - 1 do
        local number = interval * i
        if number ~= 0 then
            table.insert(numbers, number)
        end
    end
    return numbers
end
function wfuncs:tpsafe(place, s, div)
    if wfuncs:isalivecheck() then
        local speed = s or 0
        local count = div or 10
        local amt = wfuncs:generateNumbers(count)
        local start = wfuncs:getroot().Position
        local endPos = place.Position
        local totalDistance = (endPos - start).Magnitude
        for i, v in ipairs(amt) do
            local spot
            if i == 1 then
                spot = start
            else
                spot = start:Lerp(endPos, v)
            end
            wfuncs:nc():Fire()
            wfuncs:getroot().CFrame = CFrame.new(spot)
            task.wait(speed)
            local currentDistance = (spot - start).Magnitude
            if currentDistance >= totalDistance then
                break
            end
        end
    end
end
