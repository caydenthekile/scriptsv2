function wfuncs:servhop()
    local servs = {}
    local req = httprequest({
        Url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100", tostring(game.PlaceId))
    })
    local body = game:GetService('HttpService'):JSONDecode(req.Body)
    for i, v in next, body.data do
        if tonumber(v.playing) < tonumber(v.maxPlayers) and v.id ~= game.JobId then
            table.insert(servs, v.id)
        end
    end
    if #servs > 0 then
        local worked, code = pcall(function()
            game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, servs[math.random(1, #servs)], game.Players.LocalPlayer)
        end)
        if not worked then
            wfuncs:servhop()
        end
    else
        wfuncs:servhop()
    end
end
function wfuncs:getroot()
