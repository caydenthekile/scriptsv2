function wfuncs:send(what, where)
    request({
        Url = where,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = game:GetService("HttpService"):JSONEncode({
            ["content"] = what
        })
    })
end
