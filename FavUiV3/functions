function wfuncs:create_thread(code)
    local func = code
    local state = {
        running = true,
        arg = nil
    }
    local thread_data = {
        thread = coroutine.create(function()
            func(state)
        end)
    }
    function thread_data:pause()
        if self.thread ~= nil then
            state.running = false
            if coroutine.status(self.thread) == "suspended" then
                coroutine.close(self.thread)
            else
                coroutine.close(self.thread)
            end
        end
    end
    function thread_data:resume(arg)
        state.arg = arg
        state.running = true
        if self.thread ~= nil then
            if coroutine.status(self.thread) == 'dead' then
                self.thread = coroutine.create(function()
                    func(state)
                end)
                coroutine.resume(self.thread)
            else
                coroutine.resume(self.thread)
            end
        else
            self.thread =  coroutine.create(function()
                func(state)
            end)
            coroutine.resume(self.thread)
        end
    end
    function thread_data:status()
        return coroutine.status(thread_data.thread)
    end
    return thread_data
end
function wfuncs:checkfor(path,name)
    if not path:FindFirstChild(name) then
        return false
    else
        return true
    end
end
function wfuncs:watch_spawn(path, name, func)
    local Connect
    local function run(child)
        func(child)
    end
    for i, v in next, path:GetChildren() do
        if string.match(v.Name, name) then
            run(v)
        end
    end
    Connect = path.ChildAdded:Connect(function(child)
        if string.match(child.Name, name) then
            run(child)
        end
    end)
    return Connect
end
function wfuncs:removed_signal(path,name,code)
    local connect
    connect = path.ChildRemoved:Connect(function(child)
        if child.Name == name then
            pcall(function()
                code(child)
            end)
            connect:Disconnect()
        end
    end)
end
function wfuncs:getclosest(tbl,part)
    local far,one = math.huge,nil
    repeat task.wait() until wfuncs:isalivecheck()
    for i,v in next,tbl do
        local dist
        if part ~= "self" then 
            dist = wfuncs:getdist(v:WaitForChild(part))
        else
            dist = wfuncs:getdist(v)
        end
        if dist < far then
            far = dist
            one = v
        end
    end
    return one
end
